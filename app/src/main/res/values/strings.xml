    <!-- Onboarding strings -->
    <string name="onboard_step1_title">Welcome to Cadence</string>
    <string name="onboard_step1_body">Control YouTube Music completely hands-free while riding your motorcycle.</string>
    <string name="onboard_next">Next</string>
    <string name="onboard_step2_title">Notification Access</string>
    <string name="onboard_step2_body">Cadence requires Notification Access to detect and control YouTube Music playback without root.</string>
    <string name="onboard_open_settings">Open Settings</string>
    <string name="onboard_step3_title">Microphone Permission</string>
    <string name="onboard_step3_body">Microphone access is required for offline wake word and voice command recognition.</string>
    <string name="onboard_grant_mic">Grant Microphone Access</string>
    <string name="onboard_step4_title">Bluetooth Permission</string>
    <string name="onboard_step4_body">Bluetooth permission enables Cadence to automatically activate when your helmet TWS connects.</string>
    <string name="onboard_grant_bt">Grant Bluetooth Access</string>
    <string name="onboard_done_title">You\'re All Set!</string>
    <string name="onboard_done_body">Put on your helmet, connect your TWS, and say \"Hey Cade\" or \"Hai Cade\" followed by your command.</string>
    <string name="onboard_finish">Get Started</string>

    <!-- Onboarding Android 13+ Guidance -->
    <string name="onboard_step_counter">STEP %1$d OF %2$d</string>
    <string name="onboard_restricted_guide_title">Android 13+ Setup Guide</string>
    <string name="onboard_restricted_guide_body">Because Cadence is sideloaded, Android blocks Notification Access by default:\n\n1. Tap \"1. Open Cadence Info\" below.\n2. In the top-right corner, tap the 3-dot menu (⋮) > \"Allow restricted settings\".\n3. Return here and tap \"2. Open Notification Access\" to turn on Cadence.</string>
    <string name="onboard_btn_open_app_info">1. Open Cadence Info (3-Dots)</string>
    <string name="onboard_btn_open_notification">2. Open Notification Access</string>
    <string name="onboard_notification_granted">✓ Notification Access Granted!</string>
    <string name="onboard_step_bg_title">Background Music Search</string>
    <string name="onboard_step_bg_body">Allow Cadence to display over other apps so voice commands can open and play songs directly from outside the app or with the screen locked in your pocket.</string>
    <string name="onboard_grant_bg">Grant Background Search</string>
    <string name="onboard_bg_granted">✓ Background Search Permission Active!</string>

