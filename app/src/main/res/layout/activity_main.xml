<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- App / Target Status -->
    <TextView
        android:id="@+id/tv_target_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/target_disconnected"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Current Track Title -->
    <TextView
        android:id="@+id/tv_current_track"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/no_track_playing"
        android:textColor="@color/onBackground"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Current Track Artist -->
    <TextView
        android:id="@+id/tv_current_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/unknown_artist"
        android:textColor="#9E9E9E"
        android:textSize="16sp" />

    <!-- Playback State -->
    <TextView
        android:id="@+id/tv_playback_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/status_unknown"
        android:textColor="@color/onBackground"
        android:textSize="14sp" />

    <!-- Transport Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_previous"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textSize="12sp"
            android:maxLines="1"
            android:text="@string/btn_previous" />

        <Button
            android:id="@+id/btn_play_pause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textSize="12sp"
            android:maxLines="1"
            android:text="@string/btn_play" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textSize="12sp"
            android:maxLines="1"
            android:text="@string/btn_next" />

    </LinearLayout>

    <!-- Search & Play Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_search_query"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/search_hint"
            android:textColor="@color/onBackground"
            android:textColorHint="#757575"
            android:textSize="14sp"
            android:maxLines="1"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_search_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/search_button"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_search_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/primary"
        android:textSize="14sp" />

    <!-- Voice Control Section -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingVertical="12dp">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swVoiceControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_toggle_label"
            android:textColor="@color/onBackground" />

        <TextView
            android:id="@+id/tvVoiceState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:textColor="@color/primary"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/swTtsFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/tts_toggle_label"
        android:textColor="@color/onBackground" />

    <TextView
        android:id="@+id/tvLastTranscript"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/onBackground"
        android:textSize="15sp"
        android:textStyle="italic"
        android:text="@string/transcript_placeholder" />

    <!-- Permission Management Section -->
    <TextView
        android:id="@+id/tv_permission_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="@string/permission_notification_missing"
        android:textColor="#B0B0B0"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_permission_notification"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_permission_notification" />

</LinearLayout>
